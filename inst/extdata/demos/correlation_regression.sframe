  "version": "1.0.0",
  "meta": {
    "title": "What goes with getting value from the event?",
    "version": "1.0.0",
    "description": "A customer satisfaction study of what goes with the value customers get from a service, by correlation and regression.",
    "authors": "Demo author",
    "languages": "en",
    "validated": true,
    "created_at": "2026-08-28T10:20:47Z"
  },
  "items": [
    {
      "id": "sessions_attended",
      "label": "How many times did you use the service this year?",
      "type": "numeric",
      "required": true,
      "reverse": false
    },
    {
      "id": "networking_minutes",
      "label": "Roughly how many minutes did you spend with our staff?",
      "type": "slider",
      "required": false,
      "reverse": false,
      "slider_min": 0,
      "slider_max": 240,
      "slider_step": 5
    },
    {
      "id": "overall_value",
      "label": "Overall, how much value did you get from the service? (0 to 100)",
      "type": "slider",
      "required": false,
      "reverse": false,
      "slider_min": 0,
      "slider_max": 100,
      "slider_step": 1
    },
    {
      "id": "age",
      "label": "How old are you?",
      "type": "numeric",
      "required": false,
      "reverse": false
    }
  ],
  "choices": [],
  "scales": [],
  "branching": [],
  "checks": [],
  "analysis_plan": [
    {
      "id": "RQ1",
      "research_question": "Do use of the service and perceived value go together?",
      "family": "correlation",
      "method": "correlation_pearson",
      "roles": {
        "x": "sessions_attended",
        "y": "overall_value"
      },
      "objective": "O1",
      "hypotheses": {
        "null": "Use and perceived value are not correlated.",
        "alternative": "Use and perceived value are correlated."
      },
      "decision_rule": "Reject H0 if p < .05, and report the effect size with its 95% confidence interval.",
      "options": [],
      "reporting_references": [],
      "status": "draft",
      "requires_data": true,
      "test": "correlation_pearson",
      "interpretation": "",
      "citations": []
    },
    {
      "id": "RQ2",
      "research_question": "Do use and perceived value go together on ranks?",
      "family": "correlation",
      "method": "correlation_spearman",
      "roles": {
        "x": "sessions_attended",
        "y": "overall_value"
      },
      "objective": "O1",
      "hypotheses": {
        "null": "Use and perceived value are not rank-correlated.",
        "alternative": "Use and perceived value are rank-correlated."
      },
      "decision_rule": "Reject H0 if p < .05 on this rank-based test, and report the effect size with its 95% confidence interval.",
      "options": [],
      "reporting_references": [],
      "status": "draft",
      "requires_data": true,
      "test": "correlation_spearman",
      "interpretation": "",
      "citations": []
    },
    {
      "id": "RQ3",
      "research_question": "Do use and perceived value go together, by Kendall's tau?",
      "family": "correlation",
      "method": "correlation_kendall",
      "roles": {
        "x": "sessions_attended",
        "y": "overall_value"
      },
      "objective": "O1",
      "hypotheses": {
        "null": "Use and perceived value are not associated by Kendall's tau.",
        "alternative": "Use and perceived value are associated by Kendall's tau."
      },
      "decision_rule": "Reject H0 if p < .05 on this rank-based test, and report the effect size with its 95% confidence interval.",
      "options": [],
      "reporting_references": [],
      "status": "draft",
      "requires_data": true,
      "test": "correlation_kendall",
      "interpretation": "",
      "citations": []
    },
    {
      "id": "RQ4",
      "research_question": "Does the relationship hold once age is held constant?",
      "family": "correlation",
      "method": "partial_correlation",
      "roles": {
        "x": "sessions_attended",
        "y": "overall_value",
        "controls": "age"
      },
      "objective": "O1",
      "hypotheses": {
        "null": "Holding age constant, use and value are not correlated.",
        "alternative": "Holding age constant, use and value are correlated."
      },
      "decision_rule": "Reject H0 if p < .05, and report the effect size with its 95% confidence interval.",
      "options": [],
      "reporting_references": [],
      "status": "draft",
      "requires_data": true,
      "test": "partial_correlation",
      "interpretation": "",
      "citations": []
    },
    {
      "id": "RQ5",
      "research_question": "How much value do sessions and networking together explain?",
      "family": "regression",
      "method": "regression_linear",
      "roles": {
        "predictors": [
          "sessions_attended",
          "networking_minutes"
        ],
        "dependent": "overall_value"
      },
      "objective": "O2",
      "hypotheses": {
        "null": "Use and staff time explain none of the variance in value.",
        "alternative": "Use and staff time explain some of the variance in value."
      },
      "decision_rule": "Reject H0 if p < .05, and report the effect size with its 95% confidence interval.",
      "options": [],
      "reporting_references": [],
      "status": "draft",
      "requires_data": true,
      "test": "regression_linear",
      "interpretation": "",
      "citations": []
    }
  ],
  "models": [],
  "render": {
    "welcome": {
      "title": "What goes with getting value from the event?",
      "intro_text": "Thank you for taking part. This survey takes a few minutes.",
      "consent_text": "I agree to take part, and for my answers to be used for this study.",
      "consent_required": true,
      "start_label": "Start"
    },
    "thankyou": {
      "message": "Thank you for completing this survey."
    }
  },
  "study": {
    "problem": "A service provider wants to know which parts of a customer's experience go with the value they report, to decide where to invest.",
    "objectives": [
      {
        "id": "O1",
        "text": "Measure how use of the service relates to perceived value."
      },
      {
        "id": "O2",
        "text": "Estimate how much use and staff time together explain value."
      }
    ],
    "sampling": {
      "population": "Customers who used the service in the last year",
      "method": "simple_random",
      "planned_n": 120
    }
  }
}
