  "study": {
    "problem": "A training unit needs evidence that a one-day workshop changes participants' confidence, not only that they enjoyed it.",
    "objectives": [
      {
        "id": "O1",
        "text": "Measure the change in confidence from before to after the training."
      },
      {
        "id": "O2",
        "text": "Measure the change in willingness to recommend it."
      }
    ],
    "sampling": {
