    {
      "id": "RQ2",
      "research_question": "Does manager support weaken the link from workload to stress?",
      "family": "model",
      "method": "moderation",
      "roles": {
        "predictor": "workload",
        "moderator": "support",
        "outcome": "stress"
      },
      "objective": "O2",
      "hypotheses": {
        "null": "The effect of workload on stress does not depend on manager support.",
        "alternative": "The effect of workload on stress depends on manager support."
      },
      "decision_rule": "Reject H0 if p < .05 for the interaction term, and report the simple slopes.",
      "options": [],
      "reporting_references": [],
      "status": "draft",
      "requires_data": true,
      "test": "moderation",
