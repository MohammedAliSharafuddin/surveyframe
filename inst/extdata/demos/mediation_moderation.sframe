  "analysis_plan": [
    {
      "id": "RQ1",
      "research_question": "Does stress carry the effect of workload to wellbeing?",
      "family": "model",
      "method": "mediation",
      "roles": {
        "predictor": "workload",
        "mediator": "stress",
        "outcome": "wellbeing"
      },
      "objective": "O1",
      "hypotheses": {
        "null": "Stress does not carry the effect of workload to wellbeing.",
        "alternative": "Stress carries part of the effect of workload to wellbeing."
      },
      "decision_rule": "Treat the indirect effect as present when its 95% bootstrap confidence interval excludes 0.",
      "options": [],
      "reporting_references": [],
