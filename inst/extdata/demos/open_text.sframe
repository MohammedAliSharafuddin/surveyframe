  "study": {
    "problem": "Rating questions tell organisers how much attendees liked the event, not why. The open answers hold the reasons.",
    "objectives": [
      {
        "id": "O1",
        "text": "Describe the words and topics in what worked and what to change."
      },
      {
        "id": "O2",
        "text": "Compare what in-person and online attendees write."
