  "meta": {
    "title": "Satisfaction across regions",
    "version": "1.0.0",
    "description": "A resident satisfaction survey whose sample over-represents 1 region, weighted back to the population's regional shares.",
    "authors": "Demo author",
    "languages": "en",
    "validated": true,
    "created_at": "2026-11-14T09:15:15Z"
  },
  "items": [
    {
      "id": "region",
      "label": "Which region do you live in?",
      "type": "single_choice",
      "required": true,
      "choice_set": "region",
      "reverse": false
    },
    {
      "id": "satisfied",
      "label": "I am satisfied with the service in my area.",
      "type": "likert",
      "required": true,
      "choice_set": "agree5",
      "reverse": false
    },
    {
      "id": "recommend",
      "label": "Would you recommend the service to a neighbour?",
      "type": "single_choice",
      "required": true,
      "choice_set": "yn",
      "reverse": false
    }
  ],
  "choices": [
    {
      "id": "agree5",
      "values": [1, 2, 3, 4, 5],
      "labels": ["Strongly disagree", "Disagree", "Neither agree nor disagree", "Agree", "Strongly agree"],
      "allow_other": false,
      "randomise": false
    },
    {
      "id": "region",
      "values": ["north", "south", "east"],
      "labels": ["North", "South", "East"],
      "allow_other": false,
      "randomise": false
    },
    {
      "id": "yn",
      "values": ["no", "yes"],
      "labels": ["No", "Yes"],
      "allow_other": false,
      "randomise": false
    }
  ],
