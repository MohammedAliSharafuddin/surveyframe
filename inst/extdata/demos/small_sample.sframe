  "meta": {
    "title": "A pilot with 18 attendees",
    "version": "1.0.0",
    "description": "A pilot study with 18 participants, answering the main study's questions with methods suited to a small sample.",
    "authors": "Demo author",
    "languages": "en",
    "validated": true,
    "created_at": "2026-08-28T10:20:55Z"
  },
  "items": [
    {
      "id": "format",
      "label": "How did you attend?",
      "type": "single_choice",
      "required": true,
      "choice_set": "fmt",
      "reverse": false
    },
    {
      "id": "sessions_attended",
      "label": "How many sessions did you attend?",
      "type": "numeric",
      "required": true,
      "reverse": false
    },
    {
      "id": "will_return",
      "label": "Will you attend next year?",
      "type": "single_choice",
      "required": true,
      "choice_set": "yn",
      "reverse": false
    }
  ],
  "choices": [
    {
      "id": "fmt",
      "values": ["in_person", "online"],
      "labels": ["In person", "Online"],
      "allow_other": false,
      "randomise": false
    },
    {
      "id": "yn",
      "values": ["no", "yes"],
      "labels": ["No", "Yes"],
      "allow_other": false,
      "randomise": false
    }
  ],
  "scales": [],
  "branching": [],
  "checks": [],
  "analysis_plan": [
    {
      "id": "RQ1",
      "research_question": "Do the 2 formats differ, without assuming normality?",
      "family": "group_comparison",
      "method": "mann_whitney",
      "roles": {
        "group": "format",
        "outcome": "sessions_attended"
      },
      "objective": "O1",
      "hypotheses": {
        "null": "Sessions attended have the same distribution in both formats.",
        "alternative": "Sessions attended tend to be higher in one format."
      },
      "decision_rule": "Reject H0 if p < .05 on this rank-based test, and report the effect size with its 95% confidence interval.",
      "options": [],
      "reporting_references": [],
      "status": "draft",
      "requires_data": true,
      "test": "mann_whitney",
      "interpretation": "",
      "citations": []
    },
    {
      "id": "RQ2",
      "research_question": "Is format associated with returning, on an exact test?",
      "family": "categorical",
      "method": "fisher_exact",
      "roles": {
        "row": "format",
        "column": "will_return"
      },
      "objective": "O2",
      "hypotheses": {
        "null": "Format and returning are independent.",
        "alternative": "Format and returning are associated."
      },
      "decision_rule": "Reject H0 if the exact p < .05.",
      "options": [],
      "reporting_references": [],
      "status": "draft",
      "requires_data": true,
      "test": "fisher_exact",
      "interpretation": "",
      "citations": []
    },
    {
      "id": "RQ3",
      "research_question": "Does attending more sessions predict returning, with a small-sample correction?",
      "family": "regression",
      "method": "firth_logistic",
      "roles": {
        "predictors": "sessions_attended",
        "dependent": "will_return"
      },
      "objective": "O2",
      "hypotheses": {
        "null": "Sessions attended do not change the odds of returning.",
        "alternative": "Sessions attended change the odds of returning."
      },
      "decision_rule": "Reject H0 if the penalised likelihood p < .05, and report the odds ratio with its 95% confidence interval.",
      "options": [],
      "reporting_references": [],
      "status": "draft",
      "requires_data": true,
      "test": "firth_logistic",
      "interpretation": "",
      "citations": []
    }
  ],
