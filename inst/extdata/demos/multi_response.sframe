  "meta": {
    "title": "Which sessions, and why come at all?",
    "version": "1.0.0",
    "description": "A study of which sessions attendees chose and why they came, from a choose-any item and a ranking.",
    "authors": "Demo author",
    "languages": "en",
    "validated": true,
    "created_at": "2026-08-28T10:20:54Z"
  },
  "items": [
    {
      "id": "sessions_chosen",
      "label": "Which did you attend? Choose any.",
      "type": "multiple_choice",
      "required": true,
      "choice_set": "sessions",
      "reverse": false
    },
    {
      "id": "rank_priorities",
      "label": "Rank your reasons for attending.",
      "type": "ranking",
      "required": true,
      "choice_set": "reasons",
      "reverse": false
    }
  ],
  "choices": [
    {
      "id": "sessions",
      "values": ["keynote", "workshop", "panel", "poster", "social"],
      "labels": ["Opening keynote", "Workshops", "Panel discussion", "Poster session", "Social evening"],
      "allow_other": false,
      "randomise": false
    },
    {
      "id": "reasons",
      "values": ["content", "networking", "location"],
      "labels": ["The content", "The networking", "The location"],
      "allow_other": false,
      "randomise": false
    }
  ],
