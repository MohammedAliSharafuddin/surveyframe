    {
      "id": "RQ2",
      "research_question": "Do the sessions differ in how often they were chosen?",
      "family": "categorical",
      "method": "cochran_q",
      "roles": {
        "measures": [
          "sessions_chosen__keynote",
          "sessions_chosen__workshop",
          "sessions_chosen__panel",
          "sessions_chosen__poster",
          "sessions_chosen__social"
        ]
      },
      "objective": "O2",
      "hypotheses": {
        "null": "Every session is chosen equally often.",
        "alternative": "At least 1 session is chosen more or less often."
      },
      "decision_rule": "Reject H0 if p < .05, and report the effect size with its 95% confidence interval.",
      "options": [],
      "reporting_references": [],
