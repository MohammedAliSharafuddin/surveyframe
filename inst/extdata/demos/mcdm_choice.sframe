  "meta": {
    "title": "Choosing next year's venue",
    "version": "1.0.0",
    "description": "A decision study choosing next year's venue from candidate venues, weighting the criteria and ranking the venues by 10 methods.",
    "authors": "Demo author",
    "languages": "en",
    "validated": true,
    "created_at": "2026-08-28T10:20:54Z"
  },
  "items": [
    {
      "id": "crit_pairs",
      "label": "Compare the importance of each pair of criteria",
      "type": "pairwise_comparison",
      "required": true,
      "reverse": false,
      "comparison_items": ["cost", "capacity", "transport", "catering"],
      "comparison_scale": "saaty"
    },
    {
      "id": "crit_points",
      "label": "Divide 100 points across the criteria",
      "type": "criteria_weight",
      "required": true,
      "reverse": false,
      "comparison_items": ["cost", "capacity", "transport", "catering"]
    },
    {
      "id": "crit_influence",
      "label": "How strongly does each factor influence the others?",
      "type": "pairwise_comparison",
      "required": true,
      "reverse": false,
      "comparison_items": ["cost", "capacity", "transport", "catering"],
      "comparison_scale": "influence"
    }
  ],
