{
  "sframe_format": "1.0",
  "hash": {
    "algo": "sha256",
    "value": "6790bf18453af62d4a1b724e1d2400472d6472107ccd3fed1c520f088e65ad9f",
    "canonical": "rfc8785"
  },
  "version": "1.0.0",
  "meta": {
    "title": "Who attends the most?",
    "version": "1.0.0",
    "description": "A comparison of engagement across 3 attendee roles, with attendance format as a second factor and age as a covariate.",
    "authors": "Demo author",
    "languages": "en",
    "validated": true,
    "created_at": "2026-08-28T10:20:44Z"
  },
  "items": [
    {
      "id": "attendee_role",
      "label": "Which best describes you?",
      "type": "single_choice",
      "required": true,
      "choice_set": "role",
      "reverse": false
    },
    {
      "id": "format",
      "label": "How did you attend?",
      "type": "single_choice",
      "required": true,
      "choice_set": "fmt",
      "reverse": false
    },
    {
      "id": "age",
      "label": "How old are you?",
      "type": "numeric",
      "required": false,
      "reverse": false
    },
    {
      "id": "sessions_attended",
      "label": "How many sessions did you attend?",
      "type": "numeric",
      "required": true,
      "reverse": false
    }
  ],
  "choices": [
    {
      "id": "role",
      "values": ["student", "practitioner", "academic"],
      "labels": ["Student", "Practitioner", "Academic"],
      "allow_other": false,
      "randomise": false
    },
    {
      "id": "fmt",
      "values": ["in_person", "online"],
      "labels": ["In person", "Online"],
      "allow_other": false,
      "randomise": false
    }
  ],
  "scales": [],
  "branching": [],
  "checks": [],
  "analysis_plan": [
    {
      "id": "RQ1",
      "research_question": "Do the 3 attendee roles differ in sessions attended?",
      "family": "group_comparison",
      "method": "anova_one",
      "roles": {
        "group": "attendee_role",
        "outcome": "sessions_attended"
      },
      "objective": "O1",
      "hypotheses": {
        "null": "Mean sessions attended are equal across the 3 roles.",
        "alternative": "Mean sessions attended differ for at least 1 role."
      },
      "decision_rule": "Reject H0 if p < .05, and report the effect size with its 95% confidence interval.",
      "options": [],
      "reporting_references": [],
      "status": "draft",
      "requires_data": true,
      "test": "anova_one",
      "interpretation": "",
      "citations": []
    },
    {
      "id": "RQ2",
      "research_question": "The same question without assuming normality.",
      "family": "group_comparison",
      "method": "kruskal_wallis",
      "roles": {
        "group": "attendee_role",
        "outcome": "sessions_attended"
      },
      "objective": "O1",
      "hypotheses": {
        "null": "Sessions attended have the same distribution across roles.",
        "alternative": "Sessions attended differ in distribution for at least 1 role."
      },
      "decision_rule": "Reject H0 if p < .05 on this rank-based test, and report the effect size with its 95% confidence interval.",
      "options": [],
      "reporting_references": [],
      "status": "draft",
      "requires_data": true,
      "test": "kruskal_wallis",
      "interpretation": "",
      "citations": []
    },
    {
      "id": "RQ3",
      "research_question": "Do role and format both matter?",
      "family": "group_comparison",
      "method": "anova_two",
      "roles": {
        "factor1": "attendee_role",
        "factor2": "format",
        "outcome": "sessions_attended"
      },
      "objective": "O2",
      "hypotheses": {
        "null": "Neither role, format nor their interaction affects sessions attended.",
        "alternative": "Role, format or their interaction affects sessions attended."
      },
      "decision_rule": "Reject H0 if p < .05, and report the effect size with its 95% confidence interval.",
      "options": [],
      "reporting_references": [],
      "status": "draft",
      "requires_data": true,
      "test": "anova_two",
      "interpretation": "",
      "citations": []
    },
    {
      "id": "RQ4",
      "research_question": "Does the role difference survive adjusting for age?",
      "family": "group_comparison",
      "method": "ancova",
      "roles": {
        "group": "attendee_role",
        "covariates": "age",
        "outcome": "sessions_attended"
      },
      "objective": "O2",
      "hypotheses": {
        "null": "Adjusted for age, mean sessions attended are equal across roles.",
        "alternative": "Adjusted for age, mean sessions attended differ for at least 1 role."
      },
      "decision_rule": "Reject H0 if p < .05, and report the effect size with its 95% confidence interval.",
      "options": [],
      "reporting_references": [],
      "status": "draft",
      "requires_data": true,
      "test": "ancova",
      "interpretation": "",
      "citations": []
    }
  ],
  "models": [],
  "render": {
    "welcome": {
      "title": "Who attends the most?",
      "intro_text": "Thank you for taking part. This survey takes a few minutes.",
      "consent_text": "I agree to take part, and for my answers to be used for this study.",
      "consent_required": true,
      "start_label": "Start"
    },
    "thankyou": {
      "message": "Thank you for completing this survey."
    }
  },
  "study": {
    "problem": "Organisers suspect delegates, speakers and exhibitors engage differently, and need to know whether that holds once format and age are taken into account.",
    "objectives": [
      {
        "id": "O1",
        "text": "Compare sessions attended across the 3 roles."
      },
      {
        "id": "O2",
        "text": "Test whether format and age change that comparison."
      }
    ],
    "sampling": {
      "population": "Attendees of an industry conference",
      "method": "stratified",
      "planned_n": 90
    }
  }
}
