  "meta": {
    "title": "Event feedback",
    "version": "1.0.0",
    "description": "A short feedback survey for a one-day professional event, run to describe who attended and to check the quality of the answers before the programme is planned again.",
    "authors": "Demo author",
    "languages": "en",
    "validated": true,
    "created_at": "2026-08-28T10:20:39Z"
  },
  "items": [
    {
      "id": "attendee_type",
      "label": "Have you attended this event before?",
      "type": "single_choice",
      "required": true,
      "choice_set": "attendee",
      "reverse": false
    },
    {
      "id": "age",
      "label": "How old are you?",
      "type": "numeric",
      "required": false,
      "reverse": false
    },
    {
