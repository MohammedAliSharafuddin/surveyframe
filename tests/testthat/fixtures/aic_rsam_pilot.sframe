  "checks": [],
  "analysis_plan": [
    {
      "id": "RQ1",
      "research_question": "Which AIC-RSAM factors explain behavioural intention to use the AI-assisted room-service system, and which hypotheses (H1 to H9) are supported?",
      "family": "measurement",
      "method": "pls_sem",
      "roles": {
        "model": "aic_rsam"
      },
      "options": {
        "alpha": 0.05
      }
    },
    {
      "id": "RQ1a",
      "research_question": "Do the six reflective construct scales demonstrate adequate internal consistency and convergent validity?",
      "family": "measurement",
      "method": "reliability_alpha",
      "roles": {
        "items": ["aia_1", "aia_2", "aia_3", "aia_4", "poa_1", "poa_2", "poa_3", "poa_4", "peou_1", "peou_2", "peou_3", "peou_4", "pu_1", "pu_2", "pu_3", "pu_4", "pr_1", "pr_2", "pr_3", "pr_4", "bi_1", "bi_2", "bi_3", "bi_4"]
      },
      "options": {
        "alpha": 0.05
      }
    },
    {
      "id": "RQ2",
      "research_question": "How do participants evaluate the two-mode interface design (Quick Book and Conversational Book)?",
      "family": "measurement",
      "method": "reliability_alpha",
      "roles": {
        "items": ["fe_1", "fe_2", "fe_3", "fe_4", "fe_5", "fe_6"]
      },
      "options": {
        "alpha": 0.05
      }
    }
  ],
  "models": [
    {
      "id": "aic_rsam",
      "label": "AIC-RSAM: AI-Assisted Conversational Room-Service Acceptance Model",
      "type": "pls_sem",
      "engine": "seminr",
      "measurement": {
        "constructs": [
          {
            "id": "aia",
            "label": "Perceived AI Assistance",
            "mode": "reflective",
            "items": ["aia_1", "aia_2", "aia_3", "aia_4"],
            "weights": null
          },
          {
            "id": "poa",
            "label": "Perceived Order Assurance",
            "mode": "reflective",
            "items": ["poa_1", "poa_2", "poa_3", "poa_4"],
            "weights": null
          },
          {
            "id": "peou",
            "label": "Perceived Ease of Use",
            "mode": "reflective",
            "items": ["peou_1", "peou_2", "peou_3", "peou_4"],
            "weights": null
          },
          {
            "id": "pu",
            "label": "Perceived Usefulness",
            "mode": "reflective",
            "items": ["pu_1", "pu_2", "pu_3", "pu_4"],
            "weights": null
          },
          {
            "id": "pr",
            "label": "Perceived Risk",
            "mode": "reflective",
            "items": ["pr_1", "pr_2", "pr_3", "pr_4"],
            "weights": null
          },
          {
            "id": "bi",
            "label": "Behavioural Intention to Use",
            "mode": "reflective",
            "items": ["bi_1", "bi_2", "bi_3", "bi_4"],
            "weights": null
          }
        ]
      },
      "structural": {
        "paths": [
          {
            "from": "aia",
            "to": "peou",
            "label": "H1: AIA positively influences PEOU"
          },
